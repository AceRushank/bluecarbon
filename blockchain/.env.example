# Blue Carbon MRV — Blockchain Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Polygon Amoy Testnet ──────────────────────────────────────────────────────
# Get a free RPC endpoint from: https://www.alchemy.com/ or https://infura.io/
AMOY_RPC_URL=https://rpc-amoy.polygon.technology/

# Your wallet private key (WITHOUT 0x prefix)
# Fund the wallet with test MATIC from: https://faucet.polygon.technology/
PRIVATE_KEY=0xC792fF260f3f614C1913C72dd6586d307004F7Fa

# ── Polygonscan API Key (for contract verification) ──────────────────────────
# Get from: https://polygonscan.com/apis
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# ── Optional: Gas reporter ────────────────────────────────────────────────────
REPORT_GAS=false
